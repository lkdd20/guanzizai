# The public demo runs without any environment variables. Enable these only
# after initializing PostgreSQL as described in docs/SETUP.md.
DATABASE_URL=
DATABASE_DIRECT_URL=
CONTENT_DATABASE_ENABLED=false

# Session signing and administrator access. Use independent random values.
AUTH_SESSION_SECRET=
ADMIN_ACCESS_TOKEN=
ADMIN_USERNAME=
ADMIN_ENTRY_PATH=/admin

# Optional OAuth login providers.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional email login.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional OpenAI-compatible model gateway.
NEWAPI_API_KEY=
NEWAPI_BASE_URL=https://example.invalid
NEWAPI_MODEL=configured-model
DEEPSEEK_API_KEY=


# Optional private Cloudflare R2 content bucket.
R2_ACCOUNT_ID=
R2_CONTENT_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
ASSET_BASE_URL=

# Optional maintenance settings.
FULL_REVIEW_TITLES=
