# PostgreSQL content database. Keep disabled until preview import and access tests pass.
DATABASE_URL=
DATABASE_DIRECT_URL=
CONTENT_DATABASE_ENABLED=false
# `DATABASE_DIRECT_URL` is required by `pnpm run migrate:reader-platform`.

# Private Cloudflare R2 bucket accessed through its S3-compatible API.
R2_ACCOUNT_ID=
R2_CONTENT_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional comma-separated list for complete manual review during bulk import.
FULL_REVIEW_TITLES=
