{
  "name": "guanzizai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=9 <10"
  },
  "scripts": {
    "dev": "wrangler dev --port 8788 --ip 127.0.0.1",
    "dev:next": "pnpm --dir apps/web dev",
    "deploy": "wrangler deploy",
    "deploy:next": "pnpm --dir apps/web deploy",
    "typecheck": "pnpm --dir apps/web typecheck",
    "test": "vitest run",
    "build:next": "pnpm --dir apps/web build",
    "optimize:images": "node scripts/optimize-images.mjs",
    "migrate:reader-platform": "node scripts/apply-reader-platform-migrations.mjs",
    "check:glyphs": "node scripts/check-reader-glyphs.mjs",
    "preview:next": "pnpm --dir apps/web preview"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "hono": "latest",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@electric-sql/pglite": "^0.5.4",
    "@types/node": "^26.0.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vitest": "latest",
    "wrangler": "latest"
  },
  "packageManager": "pnpm@9.15.0+sha512.76e2379760a4328ec4415815bcd6628dee727af3779aaa4c914e3944156c4299921a89f976381ee107d41f12cfa4b66681ca9c718f0668fa0831ed4c6d8ba56c"
}
